# --- Sanity CMS ---
# Créez un projet sur https://www.sanity.io/manage puis renseignez :
# 1. SANITY_PROJECT_ID  (l'identifiant du projet, ex: "abcd1234")
# 2. SANITY_DATASET     (ex: "production")
# 3. SANITY_API_TOKEN   (token d'API pour le seed uniquement - Settings > API > Tokens)

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01
SANITY_API_TOKEN=
# Secret du webhook Sanity (revalidation instantanée du blog)
# Doit être identique au "Secret" du webhook dans Sanity Dashboard > Settings > Webhooks
SANITY_REVALIDATE_SECRET=
